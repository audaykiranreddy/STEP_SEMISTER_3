public class Week3Assignment {

    // =====================================================
    // L1. SIMPLE BOOK RECORD CLASS
    // =====================================================

    static class Book {
        String title;
        double price;
    }


    // =====================================================
    // L2. TWO OBJECTS, TWO SEPARATE OCCUPANCY COUNTS
    // =====================================================

    static class ExamHall {
        String hallName;
        int seatsFilled;
    }


    // =====================================================
    // L3. READING JAVA'S DEFAULT FIELD VALUES
    // =====================================================

    static class Employee {
        String empName;
        double salary;
        boolean permanent;
    }


    // =====================================================
    // L4. BASIC CONSTRUCTOR FOR A PRODUCT
    // =====================================================

    static class Product {
        String productId;
        String productName;

        Product(String productId, String productName) {
            this.productId = productId;
            this.productName = productName;
        }
    }


    // =====================================================
    // L5. COUNTING OBJECTS WITH A STATIC FIELD
    // =====================================================

    static class Order {

        static int totalOrders = 0;

        Order() {
            totalOrders++;
        }
    }


    // =====================================================
    // MAIN METHOD
    // =====================================================

    public static void main(String[] args) {


        // -------------------------------------------------
        // L1. SIMPLE BOOK RECORD CLASS
        // -------------------------------------------------

        System.out.println("=================================");
        System.out.println("L1. SIMPLE BOOK RECORD");
        System.out.println("=================================");

        Book book = new Book();

        book.title = "Clean Code";
        book.price = 650.0;

        System.out.println(
            "Title: " + book.title +
            " | Price: Rs " + book.price
        );


        // -------------------------------------------------
        // L2. TWO OBJECTS, TWO SEPARATE OCCUPANCY COUNTS
        // -------------------------------------------------

        System.out.println();
        System.out.println("=================================");
        System.out.println("L2. EXAM HALL");
        System.out.println("=================================");

        ExamHall hallA = new ExamHall();
        ExamHall hallB = new ExamHall();

        hallA.hallName = "Block-3 Hall A";
        hallB.hallName = "Block-3 Hall B";

        hallA.seatsFilled++;
        hallA.seatsFilled++;
        hallA.seatsFilled++;
        hallA.seatsFilled++;

        System.out.println(
            hallA.hallName +
            " seatsFilled: " +
            hallA.seatsFilled
        );

        System.out.println(
            hallB.hallName +
            " seatsFilled: " +
            hallB.seatsFilled
        );


        // -------------------------------------------------
        // L3. READING JAVA'S DEFAULT FIELD VALUES
        // -------------------------------------------------

        System.out.println();
        System.out.println("=================================");
        System.out.println("L3. DEFAULT FIELD VALUES");
        System.out.println("=================================");

        Employee employee = new Employee();

        System.out.println("Name: " + employee.empName);
        System.out.println("Salary: " + employee.salary);
        System.out.println("Permanent: " + employee.permanent);


        // -------------------------------------------------
        // L4. BASIC CONSTRUCTOR FOR A PRODUCT
        // -------------------------------------------------

        System.out.println();
        System.out.println("=================================");
        System.out.println("L4. PRODUCT CONSTRUCTOR");
        System.out.println("=================================");

        Product product =
            new Product("P-1042", "Wireless Mouse");

        System.out.println(
            product.productId +
            " - " +
            product.productName
        );


        // -------------------------------------------------
        // L5. COUNTING OBJECTS WITH A STATIC FIELD
        // -------------------------------------------------

        System.out.println();
        System.out.println("=================================");
        System.out.println("L5. STATIC OBJECT COUNTER");
        System.out.println("=================================");

        Order order1 = new Order();
        Order order2 = new Order();
        Order order3 = new Order();
        Order order4 = new Order();

        System.out.println(
            "Total orders: " +
            Order.totalOrders
        );
    }
}
